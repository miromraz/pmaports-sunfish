# Maintainer: miromraz <mraz.miro@seznam.cz>
# Reference: <https://postmarketos.org/devicepkg>
pkgname=device-google-sunfish
pkgdesc="Google Pixel 4a (sunfish) — Pixel 4a-specific overlay on top of device-qcom-sm7150"
pkgver=1
pkgrel=2
url="https://github.com/miromraz/pmaports-sunfish"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	device-qcom-sm7150
	feedbackd
	firmware-google-sunfish
"
makedepends="devicepkg-dev"

source="
	deviceinfo
	google,sunfish.json
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm644 "$srcdir/google,sunfish.json" \
		"$pkgdir/usr/share/feedbackd/themes/google,sunfish.json"
}

